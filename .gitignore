# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/scripts
/tests
/certificates

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# windsurf
.windsurfrules
@.windsurfrules

# macOS
.DS_Store

# SWC cache
/.swc/

# Editor/AI configs (keep local)
/.vscode/
/.claude/
/.desloppify/
/.superpowers/
/.playwright-mcp/
*.code-workspace

# Local templates not tracked
/startup-template/

# Test files and debugging
test-*.html
test-*.js
**/test-*
**/debug-*
placeholder-*
*.test.html
*.debug.*
/app/pwa-test/
/app/test-*/
jest.config.js
jest.setup.js
TESTING_GUIDE.md

# HTTPS/server setup files
https-*.sh
https-*.mjs
https-*.js
server-https.js
start-https.*
setup-ios-https.md

# Config files (keep local)
middleware.ts

# Package manager files (only track package-lock.json)
pnpm-lock.yaml
pnpm-lock.yaml.backup
yarn.lock
*.backup

# Documentation files in root (except README, CHANGELOG, RELEASE_NOTES)
/*.md
!README.md
!CHANGELOG.md
!RELEASE_NOTES.md

# Chrome Extension build artifacts
chrome-extension/dist/
chrome-extension/*.zip
